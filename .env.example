# ============================================================
# Required to view/run the app (marketing, auth, suites, posts)
# ============================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute base URL of THIS deployment (no trailing slash).
# Local: http://localhost:3000 — Vercel: https://<project>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Required only for Milestone 3 money features (owner billing,
# Connect payouts, member subscriptions, webhooks). The app
# runs and is fully viewable without these.
# ============================================================

# Supabase → Project Settings → API → service_role (server-only secret;
# used exclusively by Stripe webhook handlers to write billing state)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys while developing)
STRIPE_SECRET_KEY=
# Signing secret for /api/webhooks/stripe (platform events)
STRIPE_WEBHOOK_SECRET=
# Signing secret for /api/webhooks/stripe-connect (account.updated)
STRIPE_CONNECT_WEBHOOK_SECRET=
# The $99/month HouseKey Suite plan price (create once in the Stripe dashboard)
STRIPE_SUITE_PLAN_PRICE_ID=
